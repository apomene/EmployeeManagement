@model EmployeeManagement.Models.Skill

<form asp-action="@ViewData["FormAction"]" method="post">
    @if (ViewData["FormAction"]?.ToString() == "Edit")
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="form-group m-5px">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group m-5px">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn @(ViewData["FormAction"]?.ToString() == "Edit" ? "btn-success" : "btn-primary") m-5px">
        @(ViewData["FormAction"]?.ToString() == "Edit" ? "Update" : "Save")
    </button>

    <a class="btn btn-secondary m-5px" asp-action="Index">Cancel</a>
</form>
