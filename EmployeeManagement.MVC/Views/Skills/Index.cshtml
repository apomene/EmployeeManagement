@model IEnumerable<EmployeeManagement.Models.Skill>

<h2>Skills</h2>
<p>
    <a class="btn btn-primary" asp-action="Create">Create New Skill</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var skill in Model)
        {
            <tr>
                <td>@skill.Name</td>
                <td>@skill.Description</td>
                <td>@skill.CreatedAt.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@skill.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@skill.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@skill.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
