@model IEnumerable<EmployeeManagement.Models.Skill>

<h2>Skills</h2>
<p>
    <a class="btn btn-primary" asp-action="Create">Create New Skill</a>
</p>
<div class="mb-3">
    <a asp-action="ExportSkills" class="btn btn-primary">Export Skills</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class ="table-dark">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var skill in Model)
        {
            <tr>
                <td>@skill.Name</td>
                <td>@skill.Description</td>
                <td>@skill.CreatedAt.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@skill.Id" class="btn btn-sm btn-info me-1">Details</a> |
                    <a asp-action="Edit" asp-route-id="@skill.Id" class="btn btn-sm btn-warning me-1">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@skill.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
