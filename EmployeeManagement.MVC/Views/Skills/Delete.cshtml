@model EmployeeManagement.Models.Skill

<h2>Delete Skill</h2>

<h4>Are you sure you want to delete this skill?</h4>
<div>
    <strong>@Model.Name</strong> - @Model.Description
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger m-5px">Delete</button>
    <a class="btn btn-secondary m-5px" asp-action="Index">Cancel</a>
</form>
