@model List<EmployeeManagement.Models.AuditLogEntry>

@{
    ViewData["Title"] = "Employee Audit Logs";
    var email = ViewBag.Email as string;
}

<h2 class="mb-4">
    @(string.IsNullOrEmpty(email)
        ? "All Audit Logs"
        : $"Audit Logs for Employee: {email}")
</h2>

<form id="emailForm" asp-controller="AuditLogs" asp-action="Employee" method="get" class="form-inline mb-4">
    <div class="form-group m-2">
        <label for="email" class="m-5px">Employee Email:</label>
        <input type="email" id="logEmail" name="email" class="form-control m-5px" value="@email" />
        <span id="emailError" style="color: red; display: none;">Please enter a valid email.</span>
    </div>
    <button type="submit" class="btn btn-primary m-2 m-5px">Search</button>
    <button type="submit" name="email" value="" class="btn btn-secondary m-2 m-5px">Get All Logs</button>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Action</th>
            <th>Entity</th>
            <th>Entity Id</th>
            <th>Performed By</th>
            <th>Timestamp</th>
            <th>Old Value</th>
            <th>New Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td><span class="badge bg-info">@log.Action</span></td>
                <td>@log.EntityName</td>
                <td>@log.EntityId</td>
                <td>@log.PerformedBy</td>
                <td>@log.Timestamp.ToString("g")</td>
                <td>
                    @if (log.OldValue != null)
                    {
                        <div class="p-2 border rounded bg-light small">
                            <strong>@log.OldValue.FirstName @log.OldValue.LastName</strong><br />
                            <span>Email: @log.OldValue.Email</span><br />
                            <span>Hire Date: @log.OldValue.HireDate.ToShortDateString()</span><br />
                            <span>Department: @log.OldValue.DepartmentId</span><br />
                            <span>Skills: @(log.OldValue.Skills != null ? string.Join(", ", log.OldValue.Skills) : "-")</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (log.NewValue != null)
                    {
                        <div class="p-2 border rounded bg-light small">
                            <strong>@log.NewValue.FirstName @log.NewValue.LastName</strong><br />
                            <span>Email: @log.NewValue.Email</span><br />
                            <span>Hire Date: @log.NewValue.HireDate.ToShortDateString()</span><br />
                            <span>Department: @log.NewValue.DepartmentId</span><br />
                            <span>Skills: @(log.NewValue.Skills != null ? string.Join(", ", log.NewValue.Skills) : "-")</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Audit Logs Pagination">
        <ul class="pagination">
            <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Employee" asp-route-email="@ViewBag.Email" asp-route-pageNumber="@(ViewBag.PageNumber - 1)">Previous</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.PageNumber == i ? "active" : "")">
                    <a class="page-link" asp-action="Employee" asp-route-email="@ViewBag.Email" asp-route-pageNumber="@i">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Employee" asp-route-email="@ViewBag.Email" asp-route-pageNumber="@(ViewBag.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

