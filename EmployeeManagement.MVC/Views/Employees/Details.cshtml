@model EmployeeManagement.MVC.Models.EmployeeViewModel

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">@Model.FirstName @Model.LastName</h2>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Hire Date:</strong> @Model.HireDate.ToShortDateString()</p>
            <p><strong>Department:</strong> @Model.DepartmentName</p>

            <h4 class="mt-4">Skills</h4>
            @if (Model.Skills.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var s in Model.Skills)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @s
                            <form asp-action="RemoveSkill" method="post" class="mb-0">
                                <input type="hidden" name="employeeId" value="@Model.Id" />
                                <input type="hidden" name="skillId" value="@s" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No skills assigned.</p>
            }

            <!-- Add new skill form -->
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Add a Skill</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddSkill" method="post" class="row g-3">
                        <input type="hidden" name="employeeId" value="@Model.Id" />
                        <select name="skillId" asp-items="Model.AvailableSkills" class="form-control"></select>
                        <button type="submit" class="btn btn-primary mt-2">Add Skill</button>                  
                    </form>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger me-2">Delete</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
