@model EmployeeManagement.Models.Employee

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">@Model.FirstName @Model.LastName</h2>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Hire Date:</strong> @Model.HireDate.ToShortDateString()</p>

            <h4 class="mt-4">Skills</h4>
            @if (Model.EmployeeSkills.Any())
            {
                <ul class="list-group">
                    @foreach (var s in Model.EmployeeSkills)
                    {
                        <li class="list-group-item">@s.Skill.Name</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No skills assigned.</p>
            }

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger me-2">Delete</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
