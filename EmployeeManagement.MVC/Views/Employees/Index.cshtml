@model IEnumerable<EmployeeManagement.Models.Employee>

<h2 class="mb-4">Employees</h2>

<div class="row mb-3">
    <div class="col-md-6">
        <form id="employeeIndexForm"  asp-action="Index" method="get" class="d-flex">
            <input type="text" name="search"
                   value="@ViewData["CurrentSearch"]"
                   class="form-control me-2"
                   placeholder="Search by name..." />
            <input type="hidden" name="sortBy" id="sortBy" value="@ViewData["CurrentSort"]" />

            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-success">+ Create New Employee</a>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="lastname_asc">
                    Last Name ↑
                </a> |
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="lastname_desc">
                    ↓
                </a>
            </th>
            <th>First Name</th>
            <th>Email</th>
            <th>
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="hiredate_asc">
                    Hire Date ↑
                </a> |
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="hiredate_desc">
                    ↓
                </a>
            </th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.LastName</td>
                <td>@emp.FirstName</td>
                <td>@emp.Email</td>
                <td>@emp.HireDate.ToShortDateString()</td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-info me-1">Details</a>
                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                    <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
          const form = document.getElementById("employeeIndexForm");
          const sortInput = document.getElementById("sortBy");

          document.querySelectorAll(".sort-link").forEach(link => {
            link.addEventListener("click", e => {
              e.preventDefault();
              sortInput.value = link.dataset.sort; // set sort key
              form.submit(); // submit with current search + new sort
            });
          });
        });
    </script>
}
