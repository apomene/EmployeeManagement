@using EmployeeManagement.Models
<h2 class="mb-4">Employees</h2>

@if (TempData["ImportResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["ImportResult"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Section with border and legend -->
<fieldset class="border p-3 mb-3">
    <legend class="float-none w-auto px-2">Set filtering</legend>
    <div class="row">
        <div class="col-md-12">
            <form id="employeeIndexForm" asp-action="Index" method="get" class="d-flex align-items-end gap-2 flex-wrap">
                <!-- Search Input -->
                <input type="text" name="search"
                       id="searchInput"
                       value="@ViewData["CurrentSearch"]"
                       class="form-control"
                       placeholder="Search by name..." />

                <!-- Skill Select -->
                <select name="skillIds" id="skillSelect" class="form-select align-self-end" multiple size="6">
                    @foreach (var skill in (ViewBag.Skills as List<Skill>) ?? new List<Skill>())
                    {
                        <option value="@skill.Id"
                                selected="@( (ViewData["SelectedSkills"] as List<int>)?.Contains(skill.Id) == true ? "selected" : null )">
                            @skill.Name
                        </option>
                    }
                </select>

                <!-- Filter Button -->
                <button type="submit" class="btn btn-primary align-self-end">Filter</button>

                <!-- Clear Filters Button -->
                <button type="button" id="clearFiltersBtn" class="btn btn-secondary align-self-end">Clear Filters</button>
                <input type="hidden" name="sortBy" id="sortBy" value="@ViewData["CurrentSort"]" />

            </form>
        </div>
    </div>
</fieldset>

<!-- Action Buttons: aligned left -->
<div class="d-flex justify-content-between mb-3 flex-wrap">
    <div>
        <a asp-action="Create" class="btn btn-success me-2 mb-2">+ Create Employee</a>
        <form asp-action="DeleteSelected" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger mb-2" onclick="return confirm('Are you sure you want to delete selected Employees?');">Delete Selected</button>
        </form>
    </div>
    <div>
        <form asp-controller="EmployeeImport" asp-action="Import" method="post" class="d-inline">
            <button type="submit" class="btn btn-success mb-2">Import Employees</button>
        </form>
    </div>
</div>

<!-- Employees Table -->
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th><input type="checkbox" id="select-all" /></th>
            <th>
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="lastname_asc">Last Name ↑</a> |
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="lastname_desc">↓</a>
            </th>
            <th>First Name</th>
            <th>Email</th>
            <th>
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="hiredate_asc">Hire Date ↑</a> |
                <a href="#" class="sort-link link-light text-decoration-none" data-sort="hiredate_desc">↓</a>
            </th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td><input type="checkbox" name="selectedIds" value="@emp.Id" /></td>
                <td>@emp.LastName</td>
                <td>@emp.FirstName</td>
                <td>@emp.Email</td>
                <td>@emp.HireDate.ToShortDateString()</td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-info me-1">Details</a>
                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                    <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


