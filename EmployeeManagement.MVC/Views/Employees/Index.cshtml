@model IEnumerable<EmployeeManagement.Models.Employee>

<h2 class="mb-4">Employees</h2>

@if (TempData["ImportResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["ImportResult"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row mb-3">
    <div class="col-md-4">
        <form id="employeeIndexForm" asp-action="Index" method="get" class="d-flex">
            <input type="text" name="search"
                   id="searchInput"
                   value="@ViewData["CurrentSearch"]"
                   class="form-control me-2"
                   placeholder="Search by name..." />
            <input type="hidden" name="sortBy" id="sortBy" value="@ViewData["CurrentSort"]" />
        </form>
    </div>
   
    <div class="col-md-4 text-end">
        <a asp-action="Create" class="btn btn-success">+ Create New Employee</a>
    </div>
    <div class="col-md-4 text-end">
        <form asp-controller="EmployeeImport" asp-action="Import" method="post">
            <button type="submit" class="btn btn-success mb-3">Import Employees</button>
        </form>
    </div>
 
   

</div>


<form asp-action="DeleteSelected" method="post">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>
                    <input type="checkbox" id="select-all" />
                </th>
                <th>
                    <a href="#" class="sort-link link-light text-decoration-none" data-sort="lastname_asc">
                        Last Name ↑
                    </a> |
                    <a href="#" class="sort-link link-light text-decoration-none" data-sort="lastname_desc">
                        ↓
                    </a>
                </th>
                <th>First Name</th>
                <th>Email</th>
                <th>
                    <a href="#" class="sort-link link-light text-decoration-none" data-sort="hiredate_asc">
                        Hire Date ↑
                    </a> |
                    <a href="#" class="sort-link link-light text-decoration-none" data-sort="hiredate_desc">
                        ↓
                    </a>
                </th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="selectedIds" value="@emp.Id" />
                    </td>
                    <td>@emp.LastName</td>
                    <td>@emp.FirstName</td>
                    <td>@emp.Email</td>
                    <td>@emp.HireDate.ToShortDateString()</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-info me-1">Details</a>
                        <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-danger mt-2" onclick="return confirm('Are you sure you want to delete selected Employees?');">Delete Selected</button>
</form>

