<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <extensions>
    <add assembly="NLog.Mongo" />
  </extensions>
  <targets>
    <!-- Human-readable console logs -->
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception}" />

    <!-- Human-readable file logs -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception}"
            createDirs="true"/>

    <!-- JSON structured logs (for ELK/Seq/etc.) -->
    <target xsi:type="File" name="jsonFile"
            fileName="${basedir}/ErrorLogs/json/${shortdate}.json"
            createDirs="true"
            layout="
            {
              'time': '${longdate}',
              'level': '${level:uppercase=true}',
              'logger': '${logger}',
              'message': '${message}',
              'exception': '${exception:format=toString,StackTrace}',
              'eventId': '${event-properties:item=EventId}',
              'user': '${aspnet-user-identity}',
              'traceId': '${aspnet-traceidentifier}'
            }"
            encoding="utf-8"
            keepFileOpen="false"
            concurrentWrites="true"
            />

    <!-- MongoDB audit logs -->
    <target xsi:type="Mongo"
            name="mongoAudit"
            connectionString="mongodb://localhost:27017/EmployeeLogs"
            collectionName="AuditLogs"
            cappedCollectionSize="10000000"
            createCollection="true">

      <!-- Define document fields -->
      <field name="time" layout="${longdate}" />
      <field name="level" layout="${level:uppercase=true}" />
      <field name="logger" layout="${logger}" />
      <field name="message" layout="${message}" />
      <field name="exception" layout="${exception:format=toString,StackTrace}" />
      <field name="user" layout="${aspnet-user-identity}" />
      <field name="traceId" layout="${aspnet-traceidentifier}" />
      <field name="employeeId" layout="${event-properties:item=EmployeeId}" />
      <field name="field" layout="${event-properties:item=Field}" />
      <field name="oldValue" layout="${event-properties:item=OldValue}" />
      <field name="newValue" layout="${event-properties:item=NewValue}" />
    </target>
  </targets>

  <rules>
    <!-- Console: only warnings and above -->
    <logger name="*" minlevel="Warn" writeTo="console" />

    <!-- Human-readable logs -->
    <logger name="*" minlevel="Info" writeTo="file" />

    <!-- JSON logs (all levels) -->
    <logger name="*" minlevel="Trace" writeTo="jsonFile" />

    <!-- MongoDB: all levels -->
    <logger name="*" minlevel="Info" writeTo="mongoAudit" />
  </rules>
</nlog>
