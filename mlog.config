<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <!-- Human-readable console logs -->
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception}" />

    <!-- Human-readable file logs -->
    <target xsi:type="File" name="file"
            fileName="logs/${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception}" />

    <!-- JSON structured logs (for ELK/Seq/etc.) -->
    <target xsi:type="File" name="jsonFile"
            fileName="logs/json/${shortdate}.json"
            layout="
            {
              'time': '${longdate}',
              'level': '${level:uppercase=true}',
              'logger': '${logger}',
              'message': '${message}',
              'exception': '${exception:format=toString,StackTrace}',
              'eventId': '${event-properties:item=EventId}',
              'user': '${aspnet-user-identity}',
              'traceId': '${aspnet-traceidentifier}'
            }"
            encoding="utf-8"
            keepFileOpen="false"
            concurrentWrites="true"
            />
  </targets>

  <rules>
    <!-- Console: only warnings and above -->
    <logger name="*" minlevel="Warn" writeTo="console" />

    <!-- Human-readable logs -->
    <logger name="*" minlevel="Info" writeTo="file" />

    <!-- JSON logs (all levels) -->
    <logger name="*" minlevel="Trace" writeTo="jsonFile" />
  </rules>
</nlog>
